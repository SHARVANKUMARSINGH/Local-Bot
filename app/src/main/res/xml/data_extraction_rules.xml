<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="rootfs/" />
        <exclude domain="file" path="vfs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="rootfs/" />
        <exclude domain="file" path="vfs/" />
    </device-transfer>
</data-extraction-rules>
